<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="gMKVExtractGUI.Linux.MainWindow"
        Title="gMKVExtractGUI"
        Width="1120"
        Height="760"
        MinWidth="880"
        MinHeight="620"
        Background="#F2F5F3">
  <Window.Styles>
    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#17231F" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#17231F" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#52615B" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>
  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="18">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Spacing="3">
        <TextBlock Classes="page-title" Text="gMKVExtractGUI" />
        <TextBlock Foreground="#5C6A64" Text="Matroska track extraction" />
      </StackPanel>
      <Border Grid.Column="1" Background="#E1EAE5" CornerRadius="4" Padding="12,7" VerticalAlignment="Center">
        <TextBlock x:Name="LinuxEditionText" Foreground="#2E6753" FontSize="12" FontWeight="SemiBold" Text="LINUX EDITION" />
      </Border>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="150,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="9">
      <TextBlock Classes="field-label" Grid.Row="0" Text="Input files" />
      <TextBox x:Name="InputPathBox" Grid.Row="0" Grid.Column="1" AcceptsReturn="True" Height="56" TextChanged="InputPath_Changed" Watermark="Choose one or more MKV files">
        <TextBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Add Input File(s)..." Click="AddInputFilesMenu_Click" />
            <Separator />
            <MenuItem Header="Check All Tracks" Click="SelectAll_Click" />
            <MenuItem Header="Uncheck All Tracks" Click="SelectNone_Click" />
            <Separator />
            <MenuItem Header="Remove All Input Files" Click="RemoveAllInputFiles_Click" />
            <MenuItem Header="Remove Selected Input File" Click="RemoveSelectedInputFile_Click" />
            <MenuItem Header="Open Selected File..." Click="OpenSelectedInputFile_Click" />
            <MenuItem Header="Open Selected File Folder..." Click="OpenSelectedInputFolder_Click" />
            <Separator />
            <MenuItem Header="Expand All" Click="ExpandInputFiles_Click" />
            <MenuItem Header="Collapse All" Click="CollapseInputFiles_Click" />
          </ContextMenu>
        </TextBox.ContextMenu>
      </TextBox>
      <Button x:Name="BrowseInputButton" Grid.Row="0" Grid.Column="2" Click="BrowseInput_Click" Content="Browse..." />

      <TextBlock Classes="field-label" Grid.Row="1" Text="Output folder" />
      <TextBox x:Name="OutputPathBox" Grid.Row="1" Grid.Column="1" Watermark="Choose where extracted files will be saved" />
      <Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Click="BrowseOutput_Click" Content="Choose folder..." />

      <TextBlock Classes="field-label" Grid.Row="2" Text="MKVToolNix path" />
      <TextBox x:Name="ToolPathBox" Grid.Row="2" Grid.Column="1" Text="/usr/bin" />
      <TextBlock Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Foreground="#69766F" VerticalAlignment="Center" Text="Contains mkvmerge, mkvinfo and mkvextract" />
    </Grid>

    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D8E0DB" BorderThickness="1" CornerRadius="5" Padding="16">
      <Grid RowDefinitions="Auto,1,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Classes="section-title" Text="Extractable Tracks" />
            <TextBlock x:Name="ItemCountText" Foreground="#69766F" VerticalAlignment="Center" Text="No file analyzed" />
          </StackPanel>
          <Button x:Name="SelectByTypeButton" Grid.Column="1" Click="SelectByType_Click" Content="Select by type..." IsEnabled="False" Margin="8,0,0,0" />
          <Button Grid.Column="2" Click="SelectAll_Click" Content="Select all" Margin="8,0,0,0" />
          <Button Grid.Column="3" Click="SelectNone_Click" Content="Clear" Margin="8,0,0,0" />
        </Grid>
        <Border Grid.Row="1" Background="#E3E8E5" Height="1" />
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="SegmentList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#D8E0DB" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                  <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                    <Expander.Header>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="4,2">
                        <TextBlock Foreground="#17231F" FontWeight="SemiBold" Text="{Binding FileName}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Foreground="#69766F" Text="{Binding ItemCount}" VerticalAlignment="Center" />
                      </Grid>
                    </Expander.Header>
                    <ItemsControl ItemsSource="{Binding SegmentRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="#E8ECE9" BorderThickness="0,1,0,0" Padding="6,8">
                            <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Stretch">
                              <Grid ColumnDefinitions="100,*,Auto" ColumnSpacing="12">
                                <TextBlock Grid.Column="0" Foreground="#2E6753" FontSize="11" FontWeight="SemiBold" Text="{Binding Kind}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Foreground="#17231F" Text="{Binding Summary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Foreground="#69766F" Text="{Binding Details}" VerticalAlignment="Center" />
                              </Grid>
                            </CheckBox>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Expander>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Classes="field-label" Text="Chapter format" />
        <ComboBox x:Name="ChapterFormatBox" Width="130" SelectedIndex="0">
          <ComboBoxItem Content="XML" />
          <ComboBoxItem Content="OGM" />
          <ComboBoxItem Content="CUE" />
          <ComboBoxItem Content="PBF" />
        </ComboBox>
        <CheckBox x:Name="OverwriteCheckBox" Content="Overwrite existing files" VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" Foreground="#52615B" VerticalAlignment="Center" Margin="8,0,0,0" Text="Choose an input file to begin." />
      </StackPanel>
      <StackPanel Grid.Row="1" Spacing="6">
        <StackPanel x:Name="OverallProgressPanel" Spacing="3" IsVisible="False">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="OverallProgressLabel" Classes="field-label" Text="Overall progress" />
            <TextBlock x:Name="OverallProgressPercent" Grid.Column="1" Classes="field-label" Text="0%" />
          </Grid>
          <ProgressBar x:Name="OverallProgressBar" Minimum="0" Maximum="100" Height="8" />
        </StackPanel>
        <StackPanel Spacing="3">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="FileProgressLabel" Classes="field-label" Text="File progress" TextWrapping="Wrap" />
            <TextBlock x:Name="FileProgressPercent" Grid.Column="1" Classes="field-label" Text="0%" />
          </Grid>
          <ProgressBar x:Name="FileProgressBar" Minimum="0" Maximum="100" Height="8" />
        </StackPanel>
      </StackPanel>
      <Button x:Name="ExtractButton" Grid.Row="2" Click="Extract_Click" Content="Start extraction" IsEnabled="False" MinWidth="160" HorizontalAlignment="Right" />
    </Grid>
  </Grid>
</Window>